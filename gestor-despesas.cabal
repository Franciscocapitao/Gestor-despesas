cabal-version:      2.4
name:               gestor-despesas
version:            0.1.0.0
synopsis:           Gestor de despesas pessoais (trabalho de Programacao Funcional)
build-type:         Simple

common comum
  default-language: Haskell2010
  ghc-options:      -Wall

library
  import:           comum
  hs-source-dirs:   src
  exposed-modules:  Model
                    Domain
                    Examples
  build-depends:    base >=4 && <5

executable gestor-despesas-fase1
  import:           comum
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base >=4 && <5
                  , gestor-despesas

test-suite testes
  import:           comum
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    base >=4 && <5
                  , gestor-despesas
